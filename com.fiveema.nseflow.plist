<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fiveema.nseflow</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/samrendrasingh/nse-flow-auto/run_daily.sh</string>
    </array>

    <!--
        Run daily at 6:45 PM IST. NSE publishes FII/DII data around 6:00-6:30 PM IST,
        so 6:45 PM gives a buffer for late updates.

        This job lives OUTSIDE ~/Documents (in ~/nse-flow-auto) on purpose: macOS TCC
        privacy protection blocks launchd background jobs from reading the Documents
        folder ("Operation not permitted"), which is what silently broke the previous
        setup. Running from a non-protected path needs no Full Disk Access grant.

        run_daily.sh no longer passes --force, so the Python tracker's is_market_day()
        makes weekend/holiday runs clean no-ops — we only ingest on evenings NSE
        actually releases data. launchd also fires a missed run once on wake if the
        Mac was asleep at 18:45.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>

    <!-- Logs append here. Tail them to see run history. -->
    <key>StandardOutPath</key>
    <string>/Users/samrendrasingh/nse-flow-auto/data/nse_flow_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/samrendrasingh/nse-flow-auto/data/nse_flow_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/samrendrasingh/nse-flow-auto</string>
</dict>
</plist>
